# Serveur
PORT=3001
HOST=0.0.0.0

# Base de données PostgreSQL/PostGIS (cadastre_geo géocodé)
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=cadastre_geo
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Timeout des requetes SQL (ms) - empeche les requetes orphelines
DB_STATEMENT_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# Authentification
# ---------------------------------------------------------------------------
# Cle de RECHERCHE (OBLIGATOIRE, min 16 caracteres, le serveur refuse de
# demarrer sans). C'est cette cle qui est distribuee au frontend sous le nom
# CADASTRE_API_KEY : les deux variables portent la MEME valeur, sous deux noms
# differents. Toute rotation doit changer les deux dans la meme fenetre, sinon
# toutes les recherches echouent.
MASTER_API_KEY=your_master_api_key

# Cle d'ADMINISTRATION (min 32 caracteres), OBLIGATOIREMENT differente de
# MASTER_API_KEY. Elle protege les routes qui executent du DDL sur la base
# cadastrale. Header attendu : X-Admin-API-Key.
# Si elle est absente, les routes /admin ne sont pas enregistrees du tout.
# ADMIN_API_KEY=

# CORS: liste d'origines autorisees separees par des virgules (vide = toutes)
# CORS_ORIGINS=https://proprietaire.net,https://www.proprietaire.net

# ---------------------------------------------------------------------------
# Bases d'enrichissement
# ---------------------------------------------------------------------------
# OBLIGATOIRES : sans elles le serveur refuse de demarrer.
# Elles etaient auparavant facultatives et retombaient sur un mot de passe vide,
# ce qui produisait un enrichissement systematiquement vide et silencieux.

# immo_data : ventes DVF, referentiel batiments BDNB, coproprietes
ENRICH_DB_HOST=172.17.0.1
ENRICH_DB_PORT=5434
ENRICH_DB_NAME=immo_data
ENRICH_DB_USER=immo
ENRICH_DB_PASSWORD=

# cadastre_geo : contenance cadastrale des parcelles
CADASTRE_DB_HOST=172.17.0.1
CADASTRE_DB_PORT=5434
CADASTRE_DB_NAME=cadastre_geo
CADASTRE_DB_USER=immo
CADASTRE_DB_PASSWORD=

# Timeout des requetes d'enrichissement (ms)
ENRICH_STATEMENT_TIMEOUT_MS=25000

# Schema BDNB. Laisser vide pour detection automatique du millesime present.
# Le nom change a chaque edition (bdnb_2025_07_a_open_data, puis suivant) :
# le figer ici casse silencieusement l'enrichissement au prochain import.
# BDNB_SCHEMA=

# ---------------------------------------------------------------------------
# Fonctionnalites
# ---------------------------------------------------------------------------
# Pipeline d'import BAN. Desactive par defaut : il alimente une table qu'aucune
# route de recherche n'interroge, tout en exposant du DDL et un telechargement
# de 1,5 Go. L'activer exige ADMIN_API_KEY.
# BAN_PIPELINE_ENABLED=false

# Configuration PostGIS
# La base cadastre_geo contient 22.5M propriétaires géocodés (97.99%)
# Table principale: proprietaires_geo avec colonne geom (POINT SRID 4326)
